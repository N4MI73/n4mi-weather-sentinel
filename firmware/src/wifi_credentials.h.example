#pragma once
// Copy this file to wifi_credentials.h (same folder) and fill in your real
// values. wifi_credentials.h is gitignored -- never commit real credentials.
// Matches the same pattern PropMon and APRSMon both used before their real
// captive portals existed.

#define WIFI_SSID     "YourNetworkName"
#define WIFI_PASSWORD "YourNetworkPassword"

// Address and port of YOUR Weather Sentinel server -- the container built
// from this repo's server/ folder. Replace 192.168.x.x with its real LAN
// address (a DHCP reservation for that machine keeps it from changing).
// No trailing slash. This is a plain http:// address on your own network;
// do not expose this service to the internet.
#define SERVER_BASE_URL "http://192.168.x.x:8085"
